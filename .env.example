# SwishVision Environment Variables
# Copy this file to .env and fill in your values

# Microsoft SQL Server
DB_SERVER=localhost
DB_NAME=SwishVision
DB_DRIVER=ODBC Driver 17 for SQL Server
# Set to true for Windows Authentication, false for SQL Server Authentication
DB_TRUSTED_CONNECTION=true
# Only needed if DB_TRUSTED_CONNECTION=false
DB_USERNAME=
DB_PASSWORD=

# Redis (required for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# JWT Secret — generate a random 256-bit secret, NEVER commit to git
SECRET_KEY=change-me-to-a-random-256-bit-secret

# File paths
UPLOAD_DIR=app/uploads
OUTPUT_DIR=output_videos
MODEL_DIR=models

# Upload limits
MAX_UPLOAD_SIZE_MB=500
