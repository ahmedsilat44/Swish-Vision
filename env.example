# ─────────────────────────────────────────────
# SWISH VISION — Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit your real .env to version control
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
ENV=development               # development | staging | production
SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/swishvision
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=swishvision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── File Storage ──────────────────────────────
UPLOAD_DIR=uploads/
MAX_UPLOAD_SIZE_MB=500

# ── YOLOv8 / ML Model ─────────────────────────
MODEL_PATH=models/yolov8_swish.pt
CONFIDENCE_THRESHOLD=0.5

# ── JWT Authentication ─────────────────────────
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
